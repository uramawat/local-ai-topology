{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local AI Topology Planner benchmark evidence",
  "type": "object",
  "required": ["id", "artifactId", "topology", "runtime", "contextTokens", "promptTokensPerSecond", "decodeTokensPerSecond", "recordedAt", "confidence"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "artifactId": { "type": "string" },
    "topology": { "type": "object", "required": ["nodeIds", "mode", "link"], "properties": { "nodeIds": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "mode": { "enum": ["single", "mlx", "rpc", "remote" ] }, "link": { "type": "string" } } },
    "runtime": { "type": "object", "required": ["name", "version"], "properties": { "name": { "type": "string" }, "version": { "type": "string" }, "command": { "type": "string" } } },
    "contextTokens": { "type": "integer", "minimum": 1 },
    "promptTokensPerSecond": { "type": "number", "minimum": 0 },
    "decodeTokensPerSecond": { "type": "number", "minimum": 0 },
    "recordedAt": { "type": "string", "format": "date-time" },
    "confidence": { "const": "verified" },
    "notes": { "type": "string" }
  }
}
